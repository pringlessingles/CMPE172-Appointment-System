# Copy to .env and replace these placeholders. Never commit .env.
DB_PASSWORD=replace-with-a-long-local-password
NOTIFICATION_TOKEN=replace-with-a-long-random-token
# Optional Milestone 4 AI. Set APP_PROFILES=postgres,ai to enable.
APP_PROFILES=postgres
GEMINI_API_KEY=
GEMINI_MODEL=gemini-4-hydrogen
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
